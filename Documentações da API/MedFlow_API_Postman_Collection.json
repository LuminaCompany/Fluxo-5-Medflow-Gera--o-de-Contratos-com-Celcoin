    {
      "name": "Cadastro",
      "item": [
        {
          "name": "Cadastro de um novo usuário",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Cria ou ativa o cadastro do médico. Se o CPF/CRM casar com um registro pendente (importado do DoctorID), ativa-o e responde 200; se for um cadastro totalmente novo, cria e responde 201. Divergência de identificação (CPF/CRM) com registro existente → 422.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"email\": \"string\",\n    \"password\": \"string\",\n    \"password_confirmation\": \"string\",\n    \"name\": \"string\",\n    \"cpf\": \"string\",\n    \"crm\": \"string\",\n    \"crm_state\": \"string\",\n    \"phone\": \"string\",\n    \"birthdate\": \"string\"\n  }\n}",
